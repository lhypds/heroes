# The port the page is served on: `npm run dev`, `npm run preview` and the
# PM2 process all read it from here.
PORT=3181
PM2_NAME=heroes
# Public hostname(s) the page is served from. Comma-separate more than one.
HOST=
# For ./crawl.sh and the account check at /api. Leave empty if the GitHub CLI is
# signed in.
GITHUB_TOKEN=
